---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resultados · La noche de PS">
	<main class="results">
		<header><a href="/" class="wordmark">✳ LA NOCHE DE PS</a><a href="/app">Tu gala ↗</a></header>
		<section class="intro">
			<p class="eyebrow">EL MOMENTO HA LLEGADO</p>
			<h1>La historia<br /><em>que elegimos.</em></h1>
			<p id="message" class="muted">Consultando la gala…</p>
			<button id="retry" class="retry" type="button">Volver a consultar</button>
		</section>
		<div id="results" class="results-grid" hidden></div>
	</main>
</Layout>

<script>
	import { apiRequest, getEvent } from '../lib/api';
	type Result = { rank:number; submission:{id:string;title:string;description:string;media:{url:string;thumb_url:string;kind:string}[]}; author_name?:string|null; score:number; total_votes:number };
	const message = document.querySelector<HTMLElement>('#message')!;
	const grid = document.querySelector<HTMLElement>('#results')!;
	const retry = document.querySelector<HTMLButtonElement>('#retry')!;
	async function load() {
		retry.disabled = true;
		message.textContent = 'Consultando la gala…';
		grid.hidden = true;
		try {
			const event = await getEvent();
			if (event.effective_status !== 'results_published') {
				message.textContent = event.effective_status === 'open' ? 'El ranking se revela al final de la gala.' : 'Los resultados se publicarán cuando estén listos.';
				return;
			}
			const data = await apiRequest<{photo:Result[];sticker:Result[]}>('/results');
			grid.innerHTML = '';
			for (const [category, title] of [['photo','Mejor foto'],['sticker','Mejor sticker']] as const) {
				const section = document.createElement('section');
				section.className = 'category';
				section.innerHTML = `<p class="eyebrow">${category === 'photo' ? '01' : '02'} · ${title}</p>`;
				for (const item of data[category]) {
					const article = document.createElement('article');
					article.className = 'winner';
					const media = item.submission.media[0];
					if (media) {
						const preview = media.kind === 'video' ? document.createElement('video') : document.createElement('img');
						if (preview instanceof HTMLVideoElement) { preview.src = media.url; preview.poster = media.thumb_url; preview.controls = true; preview.preload = 'metadata'; preview.setAttribute('aria-label', `Video de ${item.submission.title}`); }
						else { preview.src = media.url; preview.alt = `Imagen de ${item.submission.title}`; }
						article.append(preview);
					}
					const label = document.createElement('span'); label.className = 'rank'; label.textContent = String(item.rank).padStart(2,'0');
					const content = document.createElement('div'); content.className = 'winner-copy';
					const name = document.createElement('h2'); name.textContent = item.submission.title;
					const desc = document.createElement('p'); desc.textContent = item.submission.description;
					content.append(name, desc);
					if (item.author_name) { const author = document.createElement('small'); author.textContent = `Por ${item.author_name}`; content.append(author); }
					const score = document.createElement('strong'); score.textContent = `${item.score} pts`;
					article.append(label, content, score); section.append(article);
				}
				if (!data[category].length) { const empty = document.createElement('p'); empty.className='muted'; empty.textContent='Aún no hay postulaciones en esta categoría.'; section.append(empty); }
				grid.append(section);
			}
			grid.hidden = false; message.textContent = 'Los votos de todos hicieron esta historia.';
		} catch (error) { message.textContent = error instanceof Error ? error.message : 'No pudimos cargar los resultados.'; }
		finally { retry.disabled = false; }
	}
	retry.addEventListener('click', () => void load());
	void load();
</script>

<style>
	.results { display:flex; flex-direction:column; min-height:100vh; min-height:100svh; padding:max(22px,env(safe-area-inset-top)) max(22px,env(safe-area-inset-right)) 60px max(22px,env(safe-area-inset-left)); background:radial-gradient(ellipse at 84% 4%,#28163c,#100b1d 54%); }
	header { display:flex; align-items:center; justify-content:space-between; gap:20px; width:min(1050px,100%); margin:0 auto; }
	.wordmark,header>a:last-child { color:#d8cde5; font-size:10px; letter-spacing:.15em; text-decoration:none; }
	.intro { display:grid; grid-template-columns:minmax(0,1fr) minmax(200px,260px); grid-template-areas:"eyebrow eyebrow" "title message" "title retry"; align-content:center; align-items:end; column-gap:clamp(30px,8vw,110px); row-gap:18px; width:min(1050px,100%); min-height:min(68vh,680px); margin:0 auto; padding:48px 0 34px; }
	.eyebrow { grid-area:eyebrow; margin:0; color:var(--lime); font-size:10px; letter-spacing:.2em; text-transform:uppercase; }
	h1 { grid-area:title; margin:0; font:400 clamp(60px,9vw,96px)/.88 'Instrument Serif',Georgia,serif; letter-spacing:-.03em; }
	h1 em { color:#c39dff; }
	.muted { grid-area:message; max-width:230px; margin:0 0 3px; color:#aa9bb9; font-size:14px; line-height:1.7; }
	.results-grid { display:grid; grid-template-columns:1fr 1fr; gap:24px; width:min(1050px,100%); margin:10px auto 0; }
	.category { padding-top:16px; border-top:1px solid #ffffff28; }
	.winner { display:flex; align-items:center; gap:13px; padding:14px 0; border-bottom:1px solid #ffffff16; }
	.winner img,.winner video { width:58px; height:68px; border-radius:3px; object-fit:cover; background:#261a36; }
	.rank { align-self:flex-start; color:var(--lime); font:20px 'Instrument Serif',Georgia,serif; }
	.winner-copy { flex:1; min-width:0; }
	.winner h2 { margin:0; color:#f6efff; font:20px 'Instrument Serif',Georgia,serif; }
	.winner p { margin:4px 0; color:#aa9bb9; font-size:10px; line-height:1.5; }
	.winner small { color:#c39dff; font-size:9px; }
	.winner strong { color:#d8cde5; font-size:10px; white-space:nowrap; }
	.retry { grid-area:retry; justify-self:start; margin:0; padding:11px 15px; border:1px solid #ffffff30; border-radius:3px; color:#e4d6f4; background:#ffffff08; cursor:pointer; font:inherit; font-size:12px; transition:background .18s,border-color .18s; }
	.retry:hover:not(:disabled) { border-color:#c39dff88; background:#c39dff12; }
	.retry:disabled { cursor:wait; opacity:.6; }
	@media(max-width:700px){
		.results { padding: max(18px,env(safe-area-inset-top)) max(20px,env(safe-area-inset-right)) 34px max(20px,env(safe-area-inset-left)); }
		header { width:100%; }
		.wordmark,header>a:last-child { font-size:9px; letter-spacing:.1em; }
		.intro { grid-template-columns:1fr; grid-template-areas:"eyebrow" "title" "message" "retry"; align-content:start; align-items:start; gap:20px; min-height:0; margin:auto; padding:clamp(70px,15vh,130px) 0 50px; }
		h1 { font-size:clamp(62px,15vw,82px); line-height:.9; }
		.muted { max-width:260px; font-size:14px; }
		.results-grid { grid-template-columns:1fr; gap:20px; margin-top:0; }
		.results { padding-bottom:40px; }
	}
	@media(prefers-reduced-motion:reduce){.spinner{animation:none}}
</style>
