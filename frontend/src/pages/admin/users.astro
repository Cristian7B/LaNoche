---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Personas y auditoría · La noche de PS">
	<main class="page"><header><a href="/admin">← Administración</a><span>PERSONAS Y AUDITORÍA</span></header><section class="content"><p class="eyebrow">CONFIANZA Y SEGURIDAD</p><h1>La comunidad<br /><em>de la gala.</em></h1><nav><button data-tab="users" class="active">Personas</button><button data-tab="signals">Señales</button><button data-tab="votes">Auditoría de votos</button><button data-tab="actions">Acciones admin</button></nav><div id="users-panel"><div class="filters"><label>Buscar por correo<input id="query" placeholder="Correo de la cuenta"/></label><label class="check"><input id="blocked" type="checkbox"/>Solo bloqueadas</label><button id="search">Buscar</button></div><div id="users"></div><button id="more" hidden>Ver más</button></div><div id="audit-panel" hidden><button id="refresh">Actualizar</button><div id="audit"></div><button id="audit-more" hidden>Ver más</button></div><p id="message" class="message">Verificando permisos…</p></section></main>
</Layout>
<script>
	import{apiRequest,getMe}from'../../lib/api';import{getValidSession}from'../../lib/auth';
	type User={id:string;email:string;name:string;role:string;is_blocked:boolean;created_at:string};type Page={items:User[];next_cursor:string|null};let token='';let cursor:string|null=null;let auditCursor:string|null=null;let selectedTab='users';let requestVersion=0;	const message=document.querySelector<HTMLElement>('#message')!;const users=document.querySelector<HTMLElement>('#users')!;const audit=document.querySelector<HTMLElement>('#audit')!;const more=document.querySelector<HTMLButtonElement>('#more')!;const auditMore=document.querySelector<HTMLButtonElement>('#audit-more')!;const session=await getValidSession();if(!session)message.textContent='Inicia sesión con una cuenta administradora.';else try{const me=await getMe(session.access_token);if(me.role!=='admin')message.textContent='Esta cuenta no tiene acceso de administración.';else{token=session.access_token;message.textContent='';void loadUsers(true);}}catch(e){message.textContent=e instanceof Error?e.message:'No se pudo verificar el acceso.';}
	async function loadUsers(reset=false){const version=++requestVersion;if(reset){users.replaceChildren();cursor=null;}message.textContent='Cargando personas…';const params=new URLSearchParams({limit:'50'});const q=(document.querySelector('#query')as HTMLInputElement).value.trim();if(q)params.set('q',q);if((document.querySelector('#blocked')as HTMLInputElement).checked)params.set('blocked','true');if(cursor)params.set('cursor',cursor);try{const data=await apiRequest<Page>(`/admin/users?${params}`,{accessToken:token});if(version!==requestVersion)return;for(const user of data.items){const row=document.createElement('article');row.className='user';const info=document.createElement('div');const name=document.createElement('strong');name.textContent=user.name||'Sin nombre';const email=document.createElement('span');email.textContent=user.email;info.append(name,email);const state=document.createElement('span');state.className=user.is_blocked?'blocked':'clear';state.textContent=user.is_blocked?'Bloqueada':'Activa';const button=document.createElement('button');button.textContent=user.is_blocked?'Desbloquear':'Bloquear';button.onclick=async()=>{if(!confirm(`¿${user.is_blocked?'Desbloquear':'Bloquear'} la cuenta ${user.email}?`))return;button.disabled=true;try{await apiRequest(`/admin/users/${user.id}`,{method:'PATCH',accessToken:token,body:JSON.stringify({is_blocked:!user.is_blocked})});void loadUsers(true);}catch(e){message.textContent=e instanceof Error?e.message:'No se pudo cambiar la cuenta.';button.disabled=false;}};row.append(info,state,button);users.append(row);}cursor=data.next_cursor;more.hidden=!cursor;message.textContent=data.items.length?`${users.children.length} personas.`:'No encontramos personas.';}catch(e){if(version===requestVersion)message.textContent=e instanceof Error?e.message:'No se pudo cargar la lista.';}}
	async function loadAudit(reset=true){const version=++requestVersion;if(reset){audit.replaceChildren();auditCursor=null;}message.textContent='Cargando auditoría…';try{let path='/admin/audit/signals';if(selectedTab==='votes'||selectedTab==='actions'){path=selectedTab==='votes'?'/admin/audit/votes?limit=50':'/admin/actions?limit=50';if(auditCursor)path+=`&cursor=${encodeURIComponent(auditCursor)}`;}const result=await apiRequest<unknown>(path,{accessToken:token});if(version!==requestVersion)return;if(selectedTab==='signals'&&!Array.isArray(result)){for(const [key,value]of Object.entries(result as Record<string,unknown>)){const title=document.createElement('h2');title.textContent=key.replaceAll('_',' ');audit.append(title);const pre=document.createElement('pre');pre.textContent=JSON.stringify(value,null,2);audit.append(pre);}auditMore.hidden=true;message.textContent='Señales de auditoría actualizadas.';return;}const page=result as {items?:unknown[];next_cursor?:string|null};const rows=Array.isArray(result)?result:page.items??[];for(const value of rows){const row=document.createElement('pre');row.textContent=JSON.stringify(value,null,2);audit.append(row);}auditCursor=page.next_cursor??null;auditMore.hidden=!auditCursor;message.textContent=rows.length?`${audit.children.length} registros.`:'No hay registros para mostrar.';}catch(e){if(version===requestVersion)message.textContent=e instanceof Error?e.message:'No se pudo cargar la auditoría.';}}
	document.querySelector('#search')?.addEventListener('click',()=>void loadUsers(true));more.addEventListener('click',()=>void loadUsers());document.querySelector('#refresh')?.addEventListener('click',()=>void loadAudit(true));auditMore.addEventListener('click',()=>void loadAudit(false));for(const button of document.querySelectorAll<HTMLButtonElement>('[data-tab]'))button.addEventListener('click',()=>{selectedTab=button.dataset.tab??'users';for(const node of document.querySelectorAll('[data-tab]'))node.classList.toggle('active',node===button);const isUsers=selectedTab==='users';(document.querySelector('#users-panel')as HTMLElement).hidden=!isUsers;(document.querySelector('#audit-panel')as HTMLElement).hidden=isUsers;if(!isUsers)void loadAudit(true);});
</script>
<style is:global>
	.page { min-height:100vh; padding:max(22px,env(safe-area-inset-top)) max(20px,env(safe-area-inset-right)) 55px max(20px,env(safe-area-inset-left)); background:radial-gradient(ellipse at 82% 0%,#28163c,#100b1d 60%); }
	.page > header { display:flex; justify-content:space-between; gap:16px; width:min(1000px,100%); margin:0 auto 52px; color:#a295b2; font-size:10px; letter-spacing:.14em; }
	.page > header a { color:#e5daf0; text-decoration:none; }
	.page .content { width:min(1000px,100%); margin:auto; }
	.page .eyebrow { color:var(--lime); font-size:10px; letter-spacing:.18em; }
	.page h1 { font:400 clamp(48px,9vw,72px)/.9 'Instrument Serif',Georgia,serif; }
	.page h1 em { color:#c39dff; }
	.page nav { display:flex; flex-wrap:wrap; gap:8px; padding:14px 0; border-bottom:1px solid #ffffff20; }
	.page nav button, .page .filters button, .page #refresh, .page .user button, .page #more { padding:9px 11px; border:1px solid #ffffff28; border-radius:3px; color:#dcd0e8; background:transparent; font-size:10px; cursor:pointer; }
	.page nav button.active { border-color:#c1ff7277; color:var(--lime); }
	.page .filters { display:flex; flex-wrap:wrap; gap:8px; margin:14px 0; }
	.page .filters > label:first-child { display:grid; gap:6px; color:#cdbfda; font-size:10px; }
	.page .filters > label:first-child input { min-width:min(220px,70vw); padding:9px; border:1px solid #ffffff28; border-radius:3px; color:#f6efff; background:#191127; }
	.page .filters label.check { display:flex; align-items:center; gap:6px; color:#cdbfda; font-size:10px; }
	.page .user { display:grid; grid-template-columns:minmax(0,1fr) auto auto; align-items:center; gap:12px; padding:14px 0; border-bottom:1px solid #ffffff1d; }
	.page .user > div { display:grid; gap:4px; min-width:0; }
	.page .user strong { color:#f0e8f8; font-size:12px; overflow-wrap:anywhere; }
	.page .user span { color:#aa9bb9; font-size:10px; }
	.page .user .blocked { color:#f7969c; }
	.page .user .clear { color:var(--lime); }
	.page .user button { color:#f7969c; }
	.page #audit pre { overflow:auto; padding:12px; border-bottom:1px solid #ffffff16; color:#d8cde5; background:#ffffff06; font:10px/1.5 monospace; }
	.page .message { color:#b7abc7; font-size:11px; }
	@media(max-width:550px) { .page { padding-bottom:40px; } .page .user { grid-template-columns:minmax(0,1fr) auto; } .page .user button { grid-column:2; } .page .user > span { grid-column:2; grid-row:1; } }
</style>
