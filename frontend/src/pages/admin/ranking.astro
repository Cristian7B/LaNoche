---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Ranking privado · La noche de PS">
	<main class="page"><header><a href="/admin">← Administración</a><span>RANKING PRIVADO</span></header><section class="content"><p class="eyebrow">VOTOS Y PUNTOS</p><h1>Así va la <em>gala.</em></h1><label class="picker">Categoría<select id="category"><option value="photo">Mejor foto</option><option value="sticker">Mejor sticker</option></select></label><p id="message" class="message">Cargando ranking…</p><div id="items" class="items"></div><button id="refresh" type="button">Actualizar ranking</button></section></main>
</Layout>
<script>
	import{apiRequest,getMe}from'../../lib/api';import{getValidSession}from'../../lib/auth';
	type RankItem={rank:number;score:number;first_place_votes:number;total_votes:number;by_position?:number[];author_name?:string|null;submission:{id:string;title:string;description:string;media:{kind:string;url:string;thumb_url:string}[]}};
	const message=document.querySelector<HTMLElement>('#message')!;const items=document.querySelector<HTMLElement>('#items')!;const category=document.querySelector<HTMLSelectElement>('#category')!;const session=await getValidSession();let token='';
	if(!session)message.textContent='Inicia sesión con una cuenta administradora.';else try{const me=await getMe(session.access_token);if(me.role!=='admin')message.textContent='Esta cuenta no tiene acceso de administración.';else{token=session.access_token;void load();}}catch(e){message.textContent=e instanceof Error?e.message:'No se pudo verificar el acceso.';}
	async function load(){message.textContent='Actualizando ranking…';items.replaceChildren();try{const rows=await apiRequest<RankItem[]>(`/admin/ranking?category=${category.value}`,{accessToken:token});for(const item of rows){const row=document.createElement('article');row.className='row';const rank=document.createElement('span');rank.className='rank';rank.textContent=String(item.rank).padStart(2,'0');const media=item.submission.media[0];if(media){const image=document.createElement(media.kind==='video'?'video':'img');if(image instanceof HTMLVideoElement){image.src=media.url;image.poster=media.thumb_url;image.controls=true;}else{image.src=media.thumb_url||media.url;image.alt=item.submission.title;}row.append(rank,image);}else row.append(rank);const detail=document.createElement('div');detail.className='detail';const title=document.createElement('h2');title.textContent=item.submission.title;const desc=document.createElement('p');desc.textContent=item.submission.description;const author=document.createElement('small');author.textContent=item.author_name?`Por ${item.author_name}`:'Autor oculto';detail.append(title,desc,author);const numbers=document.createElement('div');numbers.className='numbers';for(const [label,value] of [['Puntos',item.score],['1er lugar',item.first_place_votes],['Votos',item.total_votes]] as [string,number][]){const node=document.createElement('span');node.textContent=`${label}: ${value}`;numbers.append(node);}if(item.by_position){const positions=document.createElement('small');positions.textContent=`Posiciones: ${item.by_position.join(' · ')}`;numbers.append(positions);}row.append(detail,numbers);items.append(row);}message.textContent=rows.length?`${rows.length} postulaciones en el ranking.`:'Todavía no hay postulaciones.';}catch(e){message.textContent=e instanceof Error?e.message:'No se pudo cargar el ranking.';}}
	category.addEventListener('change',()=>void load());document.querySelector('#refresh')?.addEventListener('click',()=>void load());
</script>
<style is:global>
	.page { min-height:100vh; padding:max(22px,env(safe-area-inset-top)) max(20px,env(safe-area-inset-right)) 55px max(20px,env(safe-area-inset-left)); background:radial-gradient(ellipse at 84% 0%,#28163c,#100b1d 60%); }
	.page > header { display:flex; justify-content:space-between; gap:16px; width:min(1000px,100%); margin:0 auto 52px; color:#a295b2; font-size:10px; letter-spacing:.15em; }
	.page > header a { color:#e2d6ee; text-decoration:none; }
	.page .content { width:min(1000px,100%); margin:auto; }
	.page .eyebrow { color:var(--lime); font-size:10px; letter-spacing:.18em; }
	.page h1 { font:400 clamp(52px,10vw,78px)/.9 'Instrument Serif',Georgia,serif; }
	.page h1 em { color:#c39dff; }
	.page .picker { display:flex; align-items:center; gap:12px; color:#c8b9d8; font-size:11px; }
	.page .picker select { min-height:38px; padding:9px; border:1px solid #ffffff2b; border-radius:3px; color:#f6efff; background:#191127; }
	.page .message { color:#aa9bb9; font-size:11px; }
	.page .items { margin-top:18px; border-top:1px solid #ffffff28; }
	.page .row { display:grid; grid-template-columns:32px 70px minmax(0,1fr) auto; align-items:center; gap:13px; padding:13px 0; border-bottom:1px solid #ffffff1d; }
	.page .row img, .page .row video { width:70px; height:72px; border-radius:3px; object-fit:cover; background:#211632; }
	.page .rank { color:var(--lime); font:23px 'Instrument Serif',Georgia,serif; }
	.page .detail h2 { margin:0; color:#f4ecfc; font:22px 'Instrument Serif',Georgia,serif; }
	.page .detail p { margin:4px 0; color:#aa9bb9; font-size:10px; line-height:1.5; }
	.page .detail small { color:#bf9bf2; font-size:9px; }
	.page .numbers { display:grid; gap:5px; color:#d7cbe3; font-size:9px; text-align:right; }
	.page #refresh { margin-top:22px; padding:10px 14px; border:1px solid #ffffff2b; border-radius:3px; color:#e8dff0; background:transparent; cursor:pointer; }
	@media(max-width:650px) { .page .row { grid-template-columns:26px 58px minmax(0,1fr); } .page .row img, .page .row video { width:58px; height:60px; } .page .numbers { grid-column:3; display:flex; flex-wrap:wrap; text-align:left; } .page .detail h2 { font-size:19px; } }
</style>
