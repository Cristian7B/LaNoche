---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Moderación · La noche de PS">
	<main class="page"><header><a href="/admin">← Administración</a><span>MODERACIÓN</span></header><section class="content"><p class="eyebrow">POSTULACIONES</p><h1>Cuida la <em>historia.</em></h1><div class="filters"><label>Categoría<select id="category"><option value="">Todas las categorías</option><option value="photo">Fotos</option><option value="sticker">Stickers</option></select></label><label>Estado<select id="status"><option value="published">Publicadas</option><option value="deleted">Eliminadas</option><option value="all">Todas</option></select></label><label>Buscar título<input id="query" placeholder="Título de postulación" /></label><button id="search">Buscar</button></div><p id="message" class="message">Cargando moderación…</p><div id="items" class="items"></div><button id="more" hidden>Ver más</button></section></main>
</Layout>
<script>
	import{apiRequest,getMe}from'../../lib/api';import{getValidSession}from'../../lib/auth';
	type Item={id:string;category:string;title:string;description:string;status:string;source:string;author:{id:string|null;name:string|null;email:string|null}|null;votes:{total:number;by_position:number[]}};type PageData={items:Item[];next_cursor:string|null};
	const message=document.querySelector<HTMLElement>('#message')!;const itemsBox=document.querySelector<HTMLElement>('#items')!;const more=document.querySelector<HTMLButtonElement>('#more')!;const session=await getValidSession();let token='';let cursor:string|null=null;let queryVersion=0;
	if(!session)message.textContent='Inicia sesión con una cuenta administradora.';else try{const me=await getMe(session.access_token);if(me.role!=='admin')message.textContent='Esta cuenta no tiene acceso de administración.';else{token=session.access_token;void load(true);}}catch(e){message.textContent=e instanceof Error?e.message:'No se pudo verificar el acceso.';}
	async function load(reset=false){const version=++queryVersion;if(reset){itemsBox.replaceChildren();cursor=null;}message.textContent='Buscando postulaciones…';const params=new URLSearchParams({status:(document.querySelector('#status')as HTMLSelectElement).value,limit:'50'});const category=(document.querySelector('#category')as HTMLSelectElement).value;if(category)params.set('category',category);const q=(document.querySelector('#query')as HTMLInputElement).value.trim();if(q)params.set('q',q);if(cursor)params.set('cursor',cursor);try{const data=await apiRequest<PageData>(`/admin/submissions?${params}`,{accessToken:token});if(version!==queryVersion)return;for(const item of data.items){const card=document.createElement('article');card.className='item';const body=document.createElement('div');body.className='body';const tag=document.createElement('small');tag.textContent=`${item.category==='photo'?'FOTO':'STICKER'} · ${item.status} · ${item.votes.total} votos`;const title=document.createElement('h2');title.textContent=item.title;const description=document.createElement('p');description.textContent=item.description;const author=document.createElement('span');author.textContent=item.author?.name?`Por ${item.author.name}${item.author.email?` · ${item.author.email}`:''}`:'Autor desconocido';body.append(tag,title,description,author);card.append(body);const actions=document.createElement('div');actions.className='actions';if(item.status!=='deleted'){const reason=document.createElement('input');reason.placeholder='Motivo opcional (máx. 500)';reason.setAttribute('aria-label',`Motivo para retirar ${item.title}`);reason.maxLength=500;const remove=document.createElement('button');remove.textContent='Retirar';remove.onclick=async()=>{if(!confirm(`¿Retirar “${item.title}”?`))return;remove.disabled=true;try{await apiRequest<void>(`/admin/submissions/${item.id}`,{method:'DELETE',accessToken:token,body:JSON.stringify({reason:reason.value})});void load(true);}catch(e){message.textContent=e instanceof Error?e.message:'No se pudo retirar.';remove.disabled=false;}};actions.append(reason,remove);}else{const restore=document.createElement('button');restore.textContent='Restaurar';restore.onclick=async()=>{restore.disabled=true;try{await apiRequest(`/admin/submissions/${item.id}/restore`,{method:'POST',accessToken:token});void load(true);}catch(e){message.textContent=e instanceof Error?e.message:'No se pudo restaurar.';restore.disabled=false;}};actions.append(restore);}card.append(actions);itemsBox.append(card);}cursor=data.next_cursor;more.hidden=!cursor;message.textContent=data.items.length?`${itemsBox.children.length} postulaciones en esta lista.`:'No hay postulaciones para estos filtros.';}catch(e){message.textContent=e instanceof Error?e.message:'No se pudo cargar la moderación.';}}
	document.querySelector('#search')?.addEventListener('click',()=>void load(true));document.querySelector('#status')?.addEventListener('change',()=>void load(true));document.querySelector('#category')?.addEventListener('change',()=>void load(true));more.addEventListener('click',()=>void load());
</script>
<style>
	.page{min-height:100vh;padding:max(22px,env(safe-area-inset-top)) 20px 55px;background:radial-gradient(ellipse at 85% 0%,#28163c,#100b1d 62%)}header{display:flex;justify-content:space-between;max-width:1100px;margin:0 auto 52px;color:#9f91b0;font-size:10px;letter-spacing:.16em}header a{color:#e4d6f4;text-decoration:none}.content{width:min(1100px,100%);margin:auto}.eyebrow{color:var(--lime);font-size:10px;letter-spacing:.18em}h1{margin:8px 0 22px;font:400 clamp(50px,10vw,74px)/.9 'Instrument Serif',Georgia,serif}h1 em{color:#c39dff}.filters{display:flex;gap:8px;flex-wrap:wrap}.filters select,.filters input,.actions input{padding:10px;border:1px solid #ffffff28;color:#ece2f5;background:#191127;font-size:11px}.filters button,.actions button,#more{padding:10px 13px;border:1px solid #c1ff7255;color:var(--lime);background:#c1ff7210;font-size:10px;cursor:pointer}.message{color:#b7abc7;font-size:11px}.items{display:grid;grid-template-columns:1fr 1fr;gap:12px}.item{overflow:hidden;border:1px solid #ffffff1e;background:#ffffff06}.item>img,.item>video{width:100%;height:190px;object-fit:cover}.body{padding:13px}.body small{color:var(--lime);font-size:8px;letter-spacing:.13em}.body h2{margin:7px 0;color:#f6efff;font:23px 'Instrument Serif',Georgia,serif}.body p{color:#aa9bb9;font-size:11px;line-height:1.5}.body span{color:#c39dff;font-size:10px}.actions{display:flex;gap:8px;padding:0 13px 13px}.actions input{min-width:0;flex:1}.actions button{color:#f7969c}#more{display:block;margin:18px auto}@media(max-width:620px){.items{grid-template-columns:1fr}header{margin-bottom:38px}}
</style>
