---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Proyección onsite · La noche de PS">
	<main id="stage" class="stage"><header><a href="/admin">← Salir a administración</a><span>REVELACIÓN EN VIVO</span></header><section class="screen"><p class="eyebrow">LA NOCHE DE PS · RESULTADOS</p><h1>Los resultados<br /><em>de la historia.</em></h1><p id="message" class="message">Verificando permisos y estado de la gala…</p><div id="controls" class="controls" hidden><label>Categoría<select id="category"><option value="photo">Mejor foto</option><option value="sticker">Mejor sticker</option></select></label><button id="enter" type="button">Entrar en pantalla completa ↗</button><button id="next" type="button">Revelar siguiente puesto →</button></div><article id="winner" class="winner" hidden></article><p id="counter" class="counter"></p></section></main>
</Layout>
<script>
	import{apiRequest,getEvent,getMe}from'../../lib/api';import{getValidSession}from'../../lib/auth';
	type Item={rank:number;score:number;first_place_votes:number;total_votes:number;author_name?:string|null;submission:{title:string;description:string;media:{url:string;thumb_url:string;kind:string}[]}};let token='';let data:{photo:Item[];sticker:Item[]}={photo:[],sticker:[]};let revealed=0;let currentCategory:'photo'|'sticker'='photo';let allowReveal=false;const message=document.querySelector<HTMLElement>('#message')!;const winner=document.querySelector<HTMLElement>('#winner')!;const category=document.querySelector<HTMLSelectElement>('#category')!;const next=document.querySelector<HTMLButtonElement>('#next')!;
	const session=await getValidSession();if(!session)message.textContent='Inicia sesión con una cuenta administradora.';else try{const[me,event]=await Promise.all([getMe(session.access_token),getEvent()]);if(me.role!=='admin')message.textContent='Esta cuenta no tiene acceso de administración.';else if(event.effective_status==='open')message.textContent='Cierra la gala antes de proyectar los resultados onsite.';else{token=session.access_token;data=await apiRequest('/admin/results/onsite',{accessToken:token});message.textContent='Usa el teclado, el toque o el botón para revelar cada puesto.';(document.querySelector('#controls')as HTMLElement).hidden=false;update();}}catch(e){message.textContent=e instanceof Error?e.message:'No se pudieron cargar los resultados onsite.';}
	function render(){const list=data[currentCategory].slice(0,5).reverse();const item=revealed>0?list[Math.min(revealed-1,list.length-1)]:undefined;winner.replaceChildren();winner.hidden=!item;if(!item){next.textContent=list.length?'Revelar siguiente puesto →':'No hay resultados en esta categoría';next.disabled=!list.length;(document.querySelector('#counter')as HTMLElement).textContent='';return;}const rank=document.createElement('span');rank.className='rank';rank.textContent=String(item.rank);const copy=document.createElement('div');copy.className='copy';const title=document.createElement('h2');title.textContent=item.submission.title;const desc=document.createElement('p');desc.textContent=item.submission.description;const scores=document.createElement('small');scores.textContent=`${item.score} puntos · ${item.total_votes} votos${item.author_name?` · ${item.author_name}`:''}`;copy.append(title,desc,scores);const media=item.submission.media[0];if(media){const element=document.createElement(media.kind==='video'?'video':'img');if(element instanceof HTMLVideoElement){element.src=media.url;element.poster=media.thumb_url;element.controls=true;}else{element.src=media.url;element.alt=item.submission.title;}winner.append(element);}winner.append(rank,copy);(document.querySelector('#counter')as HTMLElement).textContent=`Puesto ${item.rank} · ${revealed} de ${list.length}`;next.textContent=revealed===list.length?'Fin de esta categoría':'Revelar siguiente puesto →';next.disabled=revealed>=list.length;}
	function update(){currentCategory=category.value as 'photo'|'sticker';revealed=0;render();}
	async function reveal(){const list=data[currentCategory].slice(0,5).reverse();if(revealed>=list.length)return;if(!allowReveal){message.textContent='Entra en pantalla completa o continúa con el botón de revelar.';return;}revealed++;render();}
	category.addEventListener('change',update);next.addEventListener('click',()=>void reveal());document.querySelector('#enter')?.addEventListener('click',async()=>{allowReveal=true;try{await document.querySelector<HTMLElement>('#stage')?.requestFullscreen();message.textContent='Pantalla completa · usa → o espacio para revelar.';}catch{message.textContent='Pantalla completa no disponible. Puedes continuar con el botón de revelar.';}});
	document.addEventListener('fullscreenchange',()=>{if(!document.fullscreenElement)message.textContent='La pantalla completa terminó. Puedes volver a entrar o continuar con el botón.';});
	document.addEventListener('keydown',(event)=>{const target=event.target as HTMLElement;if(target.isContentEditable||['BUTTON','SELECT','INPUT','TEXTAREA','VIDEO'].includes(target.tagName))return;if(event.key==='ArrowRight'||event.key===' '){event.preventDefault();void reveal();}});
</script>
<style is:global>
	.stage { min-height:100vh; padding:max(24px,env(safe-area-inset-top)) max(22px,env(safe-area-inset-right)) 38px max(22px,env(safe-area-inset-left)); background:radial-gradient(ellipse at 50% 32%,#2c1943,#100b1d 68%); color:#f7f0ff; }
	.stage > header { display:flex; justify-content:space-between; gap:16px; max-width:1050px; margin:0 auto; color:#a99bb9; font-size:10px; letter-spacing:.15em; }
	.stage > header a { color:#dfd4ea; text-decoration:none; }
	.stage .screen { width:min(1050px,100%); margin:7vh auto 0; }
	.stage .eyebrow { color:var(--lime); font-size:10px; letter-spacing:.2em; }
	.stage .screen h1 { margin:12px 0; font:400 clamp(54px,10vw,92px)/.88 'Instrument Serif',Georgia,serif; letter-spacing:-.02em; }
	.stage .screen h1 em { color:#c39dff; }
	.stage .message { color:#b6a9c4; font-size:12px; line-height:1.6; }
	.stage .controls { display:flex; flex-wrap:wrap; align-items:center; gap:12px; margin:28px 0; }
	.stage .controls label { display:grid; gap:6px; color:#b6a9c4; font-size:10px; }
	.stage .controls select, .stage .controls button { min-height:42px; padding:11px 14px; border:1px solid #ffffff30; border-radius:3px; color:#f1e9fa; background:#1b1428; font-size:11px; }
	.stage .controls button:last-child { border-color:#c1ff7266; color:#17101f; background:var(--lime); cursor:pointer; }
	.stage .winner { display:grid; grid-template-columns:minmax(200px,35%) 42px minmax(0,1fr); align-items:center; gap:22px; margin-top:28px; padding:20px; border:1px solid #ffffff22; border-radius:4px; background:#ffffff08; animation:reveal .7s ease-out; }
	.stage .winner img, .stage .winner video { width:100%; max-height:380px; border-radius:3px; object-fit:cover; }
	.stage .rank { color:var(--lime); font:72px 'Instrument Serif',Georgia,serif; }
	.stage .copy h2 { margin:0; color:#fff; font:clamp(28px,5vw,52px)/.95 'Instrument Serif',Georgia,serif; }
	.stage .copy p { color:#b4a7c2; font-size:13px; line-height:1.6; }
	.stage .copy small { color:#c39dff; font-size:10px; }
	.stage .counter { color:#a99bb9; font-size:10px; letter-spacing:.12em; }
	.stage:fullscreen { overflow:auto; background:#100b1d; }
	@keyframes reveal { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
	@media(max-width:650px) { .stage .screen { margin-top:8vh; } .stage .winner { grid-template-columns:38px minmax(0,1fr); padding:12px; gap:12px; } .stage .winner img, .stage .winner video { grid-column:1/-1; max-height:300px; } .stage .rank { font-size:56px; } .stage .copy h2 { font-size:34px; } .stage .controls { align-items:stretch; flex-direction:column; } .stage .controls > * { width:100%; } }
	@media(prefers-reduced-motion:reduce) { .stage .winner { animation:none; } }
</style>
