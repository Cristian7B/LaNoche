					<path d="M0 398C59 384 104 331 155 311S222 286 264 235 319 195 348 150 388 100 423 100 476 121 508 147 550 166 592 153 644 139 681 188 747 256 840 288" fill="none" stroke="#a382cb" stroke-opacity=".47" stroke-width="2" />
					<path d="M19 451C94 431 140 374 209 360S314 315 352 279 430 229 480 249 546 274 595 251 665 240 707 273 784 316 838 317" fill="none" stroke="#a382cb" stroke-opacity=".25" />

					<path d="M400 101V93l12-7 5 2v-9q6-10 12 0v9l5-2 12 7v10Z" fill="#433052" stroke="#a382cb" stroke-opacity=".42" stroke-width="1.2" />

					<!-- Torres escalonadas y edificios bajos con esquinas redondeadas. -->
					<g fill="url(#tower-fill)">
						<path d="M44 530V451q0-6 6-6h41v-25q0-6 6-6h42q6 0 6 6v110Z" />
						<path d="M132 530V387q0-7 7-7h47v-30q0-6 6-6h26q6 0 6 6v180Z" />
						<path d="M210 530V457q0-6 6-6h50q6 0 6 6v73Z" />
						<path d="M259 530V362q0-7 7-7h15v-36q0-6 6-6h17v-32q0-6 6-6h26q6 0 6 6v249Z" />
						<path d="M326 530V398q0-6 6-6h48q6 0 6 6v132Z" />
						<path d="M379 530V355q0-7 7-7h24v-28q0-6 6-6h28q6 0 6 6v210Z" />
						<path d="M441 530V437q0-6 6-6h46q6 0 6 6v93Z" />
						<path d="M491 530V324q0-7 7-7h18v-53q0-6 6-6h30q6 0 6 6v28h26q7 0 7 7v231Z" />
						<path d="M574 530V407q0-6 6-6h40v-22q0-6 6-6h34q6 0 6 6v151Z" />
						<path d="M657 530V347q0-6 6-6h24v-26q0-6 6-6h20q6 0 6 6v215Z" />
						<path d="M709 530V431q0-6 6-6h45q6 0 6 6v99Z M759 530V460q0-6 6-6h44q6 0 6 6v70Z" />
					</g>
					<path d="M44 451q0-6 6-6h41v-25q0-6 6-6h35m0-27q0-7 7-7h47v-30q0-6 6-6h26q6 0 6 6v101m0 0h35m0 0v-89q0-7 7-7h15v-36q0-6 6-6h17v-32q0-6 6-6h26q6 0 6 6v111h37v-37q0-7 7-7h24v-28q0-6 6-6h28q6 0 6 6v111h41V324q0-7 7-7h18v-53q0-6 6-6h30q6 0 6 6v28h26q7 0 7 7v102h29v-22q0-6 6-6h31v-26q0-6 6-6h24v-26q0-6 6-6h20q6 0 6 6v110h41q6 0 6 6v23h43q6 0 6 6" fill="none" stroke="#a382cb" stroke-opacity=".5" stroke-width="1.6" />
					<g fill="#c1ff72" opacity=".5">
						<rect x="153" y="403" width="5" height="8" rx="1" /><rect x="202" y="368" width="5" height="8" rx="1" />
						<rect x="316" y="302" width="5" height="8" rx="1" /><rect x="288" y="381" width="5" height="8" rx="1" />
						<rect x="427" y="346" width="5" height="8" rx="1" /><rect x="461" y="451" width="5" height="8" rx="1" />
						<rect x="534" y="281" width="5" height="8" rx="1" /><rect x="568" y="322" width="5" height="8" rx="1" />
						<rect x="641" y="398" width="5" height="8" rx="1" /><rect x="697" y="340" width="5" height="8" rx="1" />
					</g>
				</g>
			</svg>
			<svg class="constellation" viewBox="0 0 700 440" fill="none" aria-hidden="true">
				<defs>
					<radialGradient id="moon-glow">
						<stop offset=".4" stop-color="#c39dff" stop-opacity=".24" />
						<stop offset="1" stop-color="#c39dff" stop-opacity="0" />
					</radialGradient>
					<radialGradient id="moon-disc" cx=".35" cy=".27" r=".75">
						<stop stop-color="#fcf5ff" />
						<stop offset="1" stop-color="#c5a8e4" />
					</radialGradient>
				</defs>
				<circle cx="513" cy="98" r="72" fill="url(#moon-glow)" />
				<circle cx="513" cy="98" r="35" fill="url(#moon-disc)" />
				<g stroke="#c1ff72" stroke-opacity=".8" stroke-width="1.3" stroke-linecap="round"><path d="M235 159v12m-6-6h12"/><path d="M442 155v10m-5-5h10"/><path d="M615 255v12m-6-6h12"/><path d="M85 190v8m-4-4h8"/></g>
			</svg>
		</div>

		<header class="topbar">
			<a class="brand" href="/" aria-label="La noche de PS, inicio">
				<img src="/icon.png" alt="" width="42" height="42" />
				<span>Proyección Social <i>·</i> desde 2005</span>
			</a>
			<span class="top-clock">Bogotá · <time id="bogota-time" aria-label="Hora actual en Bogotá">--:--</time></span>
		</header>

		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow"><span class="live-dot"></span><span id="event-state">Una noche para recordar</span></p>
				<h1 id="hero-title">La noche<br />de <em>PS.</em></h1>
				<p class="intro">Nuestra historia, contada en fotos y stickers.<br class="desktop-break" /> Una gala para celebrar lo que somos.</p>
				<div class="actions">
					<button class="google-button" id="google-sign-in" type="button">
						<svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19"><path fill="#4285F4" d="M21.6 12.23c0-.72-.06-1.42-.18-2.1H12v3.97h5.38a4.6 4.6 0 0 1-2 3.02v2.46h3.24c1.9-1.75 2.98-4.33 2.98-7.35Z"/><path fill="#34A853" d="M12 22c2.7 0 4.96-.9 6.62-2.42l-3.24-2.46c-.9.6-2.03.96-3.38.96-2.6 0-4.8-1.76-5.58-4.12H3.08v2.54A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.42 13.96a6 6 0 0 1 0-3.92V7.5H3.08a10 10 0 0 0 0 9l3.34-2.54Z"/><path fill="#EA4335" d="M12 5.92c1.47 0 2.79.5 3.83 1.5l2.88-2.88C16.96 2.9 14.7 2 12 2a10 10 0 0 0-8.92 5.5l3.34 2.54C7.2 7.68 9.4 5.92 12 5.92Z"/></svg>
						<span>Continuar con Google</span>
						<span class="button-arrow" aria-hidden="true">↗</span>
					</button>
					<p class="signin-note" id="signin-note" aria-live="polite">Entra para postular y votar</p>
				</div>
				<div class="category-list" id="categorias">
					<div class="category"><span class="category-index">01</span><span>Mejor foto<br />de la historia</span><span class="category-star" aria-hidden="true">✳</span></div>
					<div class="category"><span class="category-index">02</span><span>Mejor sticker<br />de la historia</span><span class="category-star" aria-hidden="true">✳</span></div>
				</div>
				<a class="results-link" href="/results">Ver resultados publicados <span aria-hidden="true">→</span></a>
			</div>
		</section>

		<footer class="footer"><span>PS <span class="footer-star">✳</span> 20 años de historias</span><span class="footer-right">Nos vemos bajo las estrellas <span aria-hidden="true">✦</span></span></footer>
		<div class="status-toast" id="status-toast" role="status" aria-live="polite"></div>
	</main>
</Layout>

<script>
	import { ApiError, getEvent } from '../lib/api';
	import { startGoogleSignIn } from '../lib/auth';

	const statusLabel = document.querySelector<HTMLElement>('#event-state');
	const toast = document.querySelector<HTMLElement>('#status-toast');
	const signInNote = document.querySelector<HTMLElement>('#signin-note');
	const signInButton = document.querySelector<HTMLButtonElement>('#google-sign-in');
	const bogotaTime = document.querySelector<HTMLTimeElement>('#bogota-time');
	const bogotaClock = new Intl.DateTimeFormat('es-CO', { timeZone: 'America/Bogota', hour: '2-digit', minute: '2-digit', hour12: false });
	function updateBogotaTime() {
		if (!bogotaTime) return;
		const now = new Date();
		bogotaTime.textContent = bogotaClock.format(now);
		bogotaTime.dateTime = now.toISOString();
	}
	updateBogotaTime();
	window.setInterval(updateBogotaTime, 30_000);

	function showMessage(message: string) {
		if (!toast) return;
		toast.textContent = message;
		toast.classList.add('visible');
		window.setTimeout(() => toast.classList.remove('visible'), 4200);
	}

	signInButton?.addEventListener('click', async () => {
		try {
			await startGoogleSignIn('/app');
		} catch (error) {
			showMessage(error instanceof Error ? error.message : 'No se pudo iniciar sesión.');
		}
	});

	async function loadEvent() {
		try {
		const event = await getEvent();
		eventLoaded = true;
		if (statusLabel) {
			statusLabel.textContent = event.effective_status === 'open'
				? 'La votación está abierta'
				: event.effective_status === 'closed'
					? 'La gala está cerrada'
					: 'Resultados publicados';
		}
		if (event.effective_status === 'closed' && signInNote) signInNote.textContent = 'Inicia sesión para consultar tu perfil';
	} catch (error) {
		if (statusLabel) statusLabel.textContent = error instanceof ApiError ? 'No pudimos cargar el estado' : 'Sin conexión con la gala';
		if (signInNote) signInNote.textContent = 'Puedes volver a intentarlo';
	}
	}
	void loadEvent();
</script>

<style>
	.landing { position: relative; isolation: isolate; display: flex; flex-direction: column; height: 100vh; height: 100svh; overflow: hidden; padding: max(22px, env(safe-area-inset-top)) max(22px, env(safe-area-inset-right)) max(18px, env(safe-area-inset-bottom)) max(22px, env(safe-area-inset-left)); background: radial-gradient(ellipse at 76% 45%, #28163c 0, #1a1028 33%, var(--night) 74%); }
	.topbar, .footer { z-index: 2; display: flex; align-items: center; justify-content: space-between; }
	.brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: #e3d9ed; font-size: 10px; letter-spacing: .16em; text-transform: uppercase; }
	.brand img { width: 32px; height: 32px; object-fit: cover; border-radius: 50%; }
	.brand i { color: var(--lime); font-style: normal; }
