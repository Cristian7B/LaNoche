					<linearGradient id="mountain-fill" x2="0" y2="1">
						<stop stop-color="#47305f" stop-opacity=".64" />
						<stop offset="1" stop-color="#241436" stop-opacity="0" />
					</linearGradient>
					<linearGradient id="tower-fill" x2="0" y2="1">
						<stop stop-color="#322047" />
						<stop offset="1" stop-color="#241436" stop-opacity="0" />
					</linearGradient>
					<linearGradient id="landscape-edges" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="840" y2="0">
						<stop stop-color="white" stop-opacity="0" />
						<stop offset=".12" stop-color="white" />
						<stop offset=".87" stop-color="white" />
						<stop offset="1" stop-color="white" stop-opacity="0" />
					</linearGradient>
					<mask id="landscape-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="840" height="530">
						<rect width="840" height="530" fill="url(#landscape-edges)" />
					</mask>
				</defs>
				<g mask="url(#landscape-mask)" stroke-linecap="round" stroke-linejoin="round">
					<!-- Cerros Orientales y la cima de Monserrate, detrás de la ciudad. -->
