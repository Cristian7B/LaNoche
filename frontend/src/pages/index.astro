	.results-link:hover { color: var(--lime); }
	.footer { color: #9687a6; font-size: 9px; letter-spacing: .1em; text-transform: uppercase; }
	.footer-star, .footer-right span { color: var(--lime); }
	.footer-right { letter-spacing: .04em; text-transform: none; }
	.ambience { position: absolute; z-index: 0; inset: 0; overflow: hidden; pointer-events: none; }
	.starfield { position: absolute; inset: 0; width: 100%; height: 100%; }
	.skyline { position: absolute; right: 0; bottom: 0; width: 61%; height: 77%; opacity: .56; }
	.constellation { position: absolute; top: 8%; right: 5%; width: min(51vw, 660px); height: 48%; opacity: .85; }
