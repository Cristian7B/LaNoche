---
import Layout from '../layouts/Layout.astro';

const stars = Array.from({ length: 108 }, (_, index) => {
	const column = index % 12;
	const row = Math.floor(index / 12);
	return {
		x: (column + ((index * 37 % 97) + 8) / 114) * 100 / 12,
		y: (row + ((index * 61 % 89) + 8) / 106) * 100 / 9,
		radius: index % 13 === 0 ? 1.5 : index % 5 === 0 ? 1 : 0.65,
		opacity: 0.18 + (index * 17 % 19) / 38,
	};
});
---

<Layout description="La noche de PS: una gala para celebrar nuestras fotos y stickers favoritos.">
	<main class="landing">
		<div class="ambience" aria-hidden="true">
			<svg class="starfield" fill="#eee3ff" role="presentation">
				{stars.map(({ x, y, radius, opacity }) => (
					<circle cx={`${x}%`} cy={`${y}%`} r={radius} opacity={opacity} />
				))}
			</svg>
			<div class="halo halo-one"></div>
			<div class="halo halo-two"></div>
			<svg class="skyline" viewBox="0 0 840 530" preserveAspectRatio="xMaxYMax meet" role="presentation">
