	.hero { position: relative; z-index: 1; flex: 1; display: flex; align-items: center; width: min(1160px, 100%); margin: 0 auto; padding: 22px 0 42px; }
	.hero-copy { position: relative; z-index: 2; width: min(500px, 100%); padding: 12px 0; }
	.eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 13px; color: var(--lime); font-size: 10px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }
	.live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 12px #c1ff72a6; }
	h1 { margin: 0; color: #f9f3ff; font-family: 'Instrument Serif', Georgia, serif; font-size: clamp(68px, 9vw, 112px); font-weight: 400; letter-spacing: -.045em; line-height: .78; }
	h1 em { color: #c39dff; font-weight: 400; }
