---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Sticker de WhatsApp · La noche de PS">
	<main class="intake-page">
		<header><a href="/" class="wordmark">✳ LA NOCHE DE PS</a><a href="/app">Tu gala ↗</a></header>
		<section class="intake-card">
			<p class="eyebrow">TU STICKER TE ESPERA</p><h1>De WhatsApp<br /><em>a la historia.</em></h1>
			<p id="message" class="message">Preparando tu sticker…</p>
			<div id="preview" class="preview" hidden></div>
			<form id="claim-form" hidden>
				<label>Título<input name="title" required minlength="3" maxlength="120" placeholder="Dale un nombre" /></label>
				<label>Descripción<textarea name="description" required minlength="10" maxlength="1000" rows="3" placeholder="Cuéntanos de dónde viene…"></textarea></label>
				<button id="claim" type="submit">Postular sticker <span>↗</span></button>
			</form>
			<a id="signin" class="signin" href="/" hidden>Continuar con Google</a>
			<a id="retry" class="retry" href="#" hidden>Volver a intentar</a>
		</section>
	</main>
</Layout>

<script>
	import { ApiError, apiRequest, getEvent, getMe } from '../../lib/api';
	import { getValidSession, startGoogleSignIn } from '../../lib/auth';
	type IntakePreview={status:'ready';category:'sticker';media:{kind:string;url:string;thumb_url:string;duration_ms?:number}};
	const token=window.location.pathname.split('/').filter(Boolean).at(-1) ?? '';
	const message=document.querySelector<HTMLElement>('#message')!;
	const preview=document.querySelector<HTMLElement>('#preview')!;
	const form=document.querySelector<HTMLFormElement>('#claim-form')!;
	const signin=document.querySelector<HTMLAnchorElement>('#signin')!;
	const retry=document.querySelector<HTMLAnchorElement>('#retry')!;
	let accessToken='';let verified=false;let humanToken='';let widgetId:string|undefined;let eventOpen=false;
	const isTokenPath=token!==''&&token!=='s';
	const setMessage=(text:string)=>{message.textContent=text;};
	const session=await getValidSession();
	if(!isTokenPath){setMessage('El enlace del sticker no es válido. Abre el enlace que recibiste por WhatsApp.');}
	else if(!session){setMessage('Inicia sesión para revisar y postular el sticker.');signin.hidden=false;signin.onclick=(event)=>{event.preventDefault();void startGoogleSignIn(`/s/${encodeURIComponent(token)}`);};}
	else {
		accessToken=session.access_token;signin.hidden=true;
		try{
			const [user,event]=await Promise.all([getMe(accessToken),getEvent()]);verified=user.human_verified;eventOpen=event.effective_status==='open';
			if(!eventOpen){setMessage('La gala está cerrada. El sticker sigue aquí, pero ya no se puede postular.');}
			let data:IntakePreview|undefined;
			for(let attempt=0;attempt<3;attempt++){
				try{data=await apiRequest<IntakePreview>(`/intakes/${encodeURIComponent(token)}`,{accessToken});break;}
				catch(error){if(error instanceof ApiError&&error.code==='INTAKE_NOT_READY'&&attempt<2){setMessage('Tu sticker aún se está procesando. Volveremos a intentarlo…');await new Promise(resolve=>window.setTimeout(resolve,2000));continue;}throw error;}
			}
			if(data){
				const media=data.media.kind==='video'?document.createElement('video'):document.createElement('img');
				if(media instanceof HTMLVideoElement){media.src=data.media.url;media.poster=data.media.thumb_url;media.controls=true;media.preload='metadata';media.setAttribute('aria-label','Vista previa del sticker');}
				else{media.src=data.media.url;media.alt='Vista previa del sticker';}
				preview.append(media);preview.hidden=false;
				if(eventOpen){form.hidden=false;setMessage('Escribe un título y una descripción para postularlo.');}
				else setMessage('La gala está cerrada. El sticker sigue aquí, pero ya no se puede postular.');
			}
		}catch(error){
			const code=error instanceof ApiError?error.code:'';
			setMessage(code==='INTAKE_EXPIRED'?'Este enlace venció. Pide un nuevo sticker al bot de WhatsApp.':code==='INTAKE_ALREADY_CLAIMED'?'Este sticker ya fue reclamado. Revisa tus postulaciones.':code==='NOT_FOUND'?'No encontramos este sticker. Comprueba que el enlace esté completo.':error instanceof Error?error.message:'No pudimos cargar el sticker.');
			retry.hidden=false;
		}
	}
	form.addEventListener('submit',async(event)=>{
		event.preventDefault();if(!eventOpen){setMessage('La gala está cerrada.');return;}
		const button=document.querySelector<HTMLButtonElement>('#claim')!;button.disabled=true;
		try{
			const data=new FormData(form);const submission=await apiRequest<{id:string}>('/intakes/'+encodeURIComponent(token)+'/claim',{method:'POST',accessToken,body:JSON.stringify({title:data.get('title'),description:data.get('description')})});
			form.hidden=true;setMessage('Listo. El sticker ya forma parte de la historia.');const link=document.createElement('a');link.href='/app/me/submissions';link.className='success-link';link.textContent='Ver mi postulación →';preview.after(link);
		}catch(error){const code=error instanceof ApiError?error.code:'';setMessage(code==='INTAKE_EXPIRED'?'El enlace venció antes de completar la postulación.':code==='INTAKE_ALREADY_CLAIMED'?'Alguien ya reclamó este sticker.':code==='EVENT_NOT_OPEN'?'La gala cerró antes de completar la postulación.':error instanceof Error?error.message:'No se pudo postular el sticker.');}
		finally{button.disabled=false;}
	});
	retry.addEventListener('click',(event)=>{event.preventDefault();window.location.reload();});
</script>

<style>
	.intake-page{min-height:100vh;padding:max(22px,env(safe-area-inset-top)) 20px 50px;background:radial-gradient(ellipse at 80% 0%,#28163c,#100b1d 63%)}header{display:flex;justify-content:space-between;max-width:760px;margin:0 auto 56px}header a{color:#d8cde5;font-size:10px;text-decoration:none}.wordmark{letter-spacing:.15em}.intake-card{width:min(540px,100%);margin:0 auto}.eyebrow{color:var(--lime);font-size:10px;letter-spacing:.2em}h1{margin:12px 0 18px;font:400 clamp(50px,11vw,76px)/.9 'Instrument Serif',Georgia,serif}h1 em{color:#c39dff}.message{color:#b7abc7;font-size:12px;line-height:1.6}.preview{margin:20px 0;border:1px solid #ffffff24;background:#ffffff08}.preview img,.preview video{display:block;max-width:100%;max-height:380px;margin:auto;object-fit:contain}form{display:grid;gap:14px;margin-top:20px}form label{display:grid;gap:7px;color:#cdbfda;font-size:11px}form input,form textarea{padding:12px;border:1px solid #ffffff2c;border-radius:3px;color:#f6efff;background:#191127;font:13px 'DM Sans',sans-serif}form textarea{resize:vertical}form button{display:flex;justify-content:space-between;padding:15px;border:0;color:#17101f;background:var(--lime);font-size:12px;font-weight:600;cursor:pointer}form button:disabled{opacity:.5}.signin,.retry,.success-link{display:inline-block;margin-top:18px;color:var(--lime);font-size:12px;text-decoration:none}.retry{color:#c39dff}.success-link{display:block}
</style>
